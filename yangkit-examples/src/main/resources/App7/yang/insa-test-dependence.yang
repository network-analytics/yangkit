module insa-test-dependence {
  yang-version 1.1;
  namespace "urn:ietf:params:xml:ns:yang:insa-testfd";
  prefix itdy;

  import insa-test {
    prefix ity;
    reference "None";
  }

  organization "INSA Lyon";

  description
    "insa-test YANG module.";

  revision 2023-09-05 {
    description "Initial version.";
  }

  container insa-container2 {
    config false;
    leaf computer2 {
        type string;
        mandatory true;
        description "computer";
    }
    leaf router2 {
        type uint8;
        description "router";
    }
    anydata payload {
        description
            "Message or notification received from network element.";
    }
  }
}
